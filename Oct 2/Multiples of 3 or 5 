"""
find the sum of all multiples of 3 or 5 below 1000
"""
def findSum(num):
    total = 0
    for i in range(num):
        if i % 3 == 0 or i % 5 == 0:
            total += i
    return total

def findSum2(num):
    return sum(i for i in range(num) if i % 3 == 0 or i % 5 == 0)

def findSum3(num):
    return sum(i for i in range(num) if not (i % 3 and i % 5))

def findSum4(num):
    total = 0
    for i in range(0, num, 3):
        total += i
    for i in range(0, num, 5):
        if i % 3 != 0:
            total += i
    return total

def findSum5(num):
    return sum(filter(lambda x: x % 3 == 0 or x % 5 == 0, range(num)))

def findSum6(num):
    return sum(filter(lambda x: not (x % 3 and x % 5), range(num)))

def findSum7(num):
    return sum(set(range(0, num, 3)).union(set(range(0, num, 5))))

def findSum8(num):
    return sum(set(range(0, num, 3)) | set(range(0, num, 5)))

def findSum9(num):
    total = 0
    num -= 1
    while num > 0: 
        if num % 3 == 0:
            total += num
        elif num % 5 == 0:
            total += num
        num -= 1
    return total


