def handToDice(hand):
    a = hand // 100
    b = (hand // 10) % 10
    c = hand % 10
    return (a, b, c)

def diceToOrderedHand(a, b, c):
    return max(a, b, c) * 100 + sorted([a, b, c])[1] * 10 + min(a, b, c)

def getNewDie(dice):
    newDice = dice % 10
    dice = dice // 10
    kept = newDice
    return (kept, dice)

def playStep2(hand, dice):
    kept1, kept2, kept3 = 0, 0, 0 # dice to keep
    a, b, c = handToDice(hand)
    if a == b:
        kept1 = a
        kept2 = b
    if b == c:
        kept2 = b
        kept3 = c
    if a == c:
        kept1 = a
        kept3 = c
    if kept1 == 0 and kept2 == 0 and kept3 == 0:
        kept1 = max(a, b, c)
    if kept2 == 0 and kept3 == 0:
        kept2, dice = getNewDie(dice)
        kept3, dice = getNewDie(dice)
    elif kept1 == 0:
        kept1, dice = getNewDie(dice)
    elif kept2 == 0:
        kept2, dice = getNewDie(dice)
    elif kept3 == 0:
        kept3, dice = getNewDie(dice)
    return (diceToOrderedHand(kept1, kept2, kept3), dice)


def score(hand):
    a, b, c = handToDice(hand)
    if a != b and b != c and a != c:
        score = max(a, b, c)
    elif a == b:
        score = 10 + a + b
    elif b == c:
        score = 10 + b + c
    elif a == c:
        score = 10 + a + c
    if a == b and b == c:
        score = 20 + a + b + c
    return score

def playThreeDiceYahtzee(dice):
    a, dice = getNewDie(dice)
    b, dice = getNewDie(dice)
    c, dice = getNewDie(dice)
    hand = diceToOrderedHand(a, b, c)
    hand, dice = playStep2(hand, dice)
    hand, dice = playStep2(hand, dice)
    return (hand, score(hand))

def testPlayThreeDiceYahtzee():
    print('Testing playThreeDiceYahtzee()...', end='')
    assert(handToDice(123) == (1,2,3))
    assert(handToDice(214) == (2,1,4))
    assert(handToDice(422) == (4,2,2))

    assert(diceToOrderedHand(1,2,3) == 321)
    assert(diceToOrderedHand(1,4,2) == 421)

    assert(playStep2(413, 2312) == (421, 23))
    assert(playStep2(544, 23) == (443, 2))
    assert(playStep2(544, 456) == (644, 45))

    assert(score(432) == 4)
    assert(score(443) == 10+4+4)
    assert(score(633) == 10+3+3)
    assert(score(555) == 20+5+5+5)

    assert(playThreeDiceYahtzee(2312413) == (432, 4))
    assert(playThreeDiceYahtzee(2633413) == (633, 16))
    assert(playThreeDiceYahtzee(2333555) == (555, 35))
    print('Passed!')

def main():
    testPlayThreeDiceYahtzee()

main()